# Commands run inside the placeholder image to prove its contract, one per
# line. Read by scripts/smoke-test.sh.
#
# It runs as the numeric non-root user, and answers 200 on an arbitrary path
# on the port PORT names (busybox wget exits non-zero on any other status).
test "$(id -u)" = 10001
PORT=9123 placeholder serve & sleep 1; wget -q -O - http://127.0.0.1:9123/any/health/path | grep -q Placeholder
# In a Container Apps job it exits 0 rather than serving until the timeout.
CONTAINER_APP_JOB_NAME=smoke timeout 5 placeholder insight --email
